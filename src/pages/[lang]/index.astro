---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { locales, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import {
  buildAlternatePaths,
  buildAlternateUrls,
  getPostLang,
  localizedUrl,
} from '../../i18n/utils';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const site = Astro.site!;

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((post) => getPostLang(post) === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const alternateUrls = buildAlternateUrls(site, lang);
const alternatePaths = buildAlternatePaths(lang);
const canonical = localizedUrl(site, lang);
---

<BaseLayout
  title="JJunior"
  description={t.siteDescription}
  lang={lang}
  canonical={canonical}
  alternateUrls={alternateUrls}
  alternatePaths={alternatePaths}
>
  <section class="hero">
    <h1>JJunior</h1>
    <p>{t.siteDescription}</p>
  </section>

  <section class="articles-section">
    <h2>{t.articlesHeading}</h2>
    {posts.length === 0 ? (
      <p class="empty-state">{t.emptyState}</p>
    ) : (
      <div class="article-list">
        {posts.map((post) => (
          <ArticleCard post={post} lang={lang} />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
