---
import BaseLayout from './BaseLayout.astro';
import { dateLocale, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import {
  buildAlternatePaths,
  buildAlternateUrls,
  localizedUrl,
} from '../i18n/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  slug: string;
  lang: Locale;
  translationKey: string;
  allPosts: CollectionEntry<'blog'>[];
}

const {
  title,
  description,
  pubDate,
  tags,
  slug,
  lang,
  translationKey,
  allPosts,
} = Astro.props;

const t = useTranslations(lang);
const site = Astro.site!;
const canonical = localizedUrl(site, lang, `blog/${slug}`);
const alternateUrls = buildAlternateUrls(site, lang, {
  posts: allPosts,
  translationKey,
});
const alternatePaths = buildAlternatePaths(lang, {
  posts: allPosts,
  translationKey,
});

const formattedDate = pubDate.toLocaleDateString(dateLocale[lang], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

/** Destaca a palavra RAG no título/descrição do artigo. */
function highlightRag(text: string) {
  return text.split(/(RAG)/g).map((part) =>
    part === 'RAG' ? { type: 'mark' as const, value: part } : { type: 'text' as const, value: part },
  );
}

const titleParts = highlightRag(title);
const descriptionParts = highlightRag(description);
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  canonical={canonical}
  alternateUrls={alternateUrls}
  alternatePaths={alternatePaths}
  type="article"
  pubDate={pubDate}
>
  <article class="article">
    <header class="article-header">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      <h1>
        {titleParts.map((part) =>
          part.type === 'mark' ? (
            <span class="term-rag">{part.value}</span>
          ) : (
            part.value
          ),
        )}
      </h1>
      <p class="article-description">
        {descriptionParts.map((part) =>
          part.type === 'mark' ? (
            <span class="term-rag">{part.value}</span>
          ) : (
            part.value
          ),
        )}
      </p>
      {tags.length > 0 && (
        <ul class="tag-list" aria-label={t.tags}>
          {tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
