---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
}

const { title, description, canonical, type, pubDate } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      type={type}
      pubDate={pubDate}
    />
  </head>
  <body>
    <Header />
    <main class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
