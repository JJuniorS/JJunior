---
import type { CollectionEntry } from 'astro:content';
import { dateLocale, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { getPostSlug, localizedPath } from '../i18n/utils';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Locale;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);
const slug = getPostSlug(post);
const formattedDate = post.data.pubDate.toLocaleDateString(dateLocale[lang], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

function highlightRag(text: string) {
  return text.split(/(RAG)/g).map((part) =>
    part === 'RAG'
      ? { type: 'mark' as const, value: part }
      : { type: 'text' as const, value: part },
  );
}

const titleParts = highlightRag(post.data.title);
const descriptionParts = highlightRag(post.data.description);
---

<article class="article-card">
  <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
  <h2>
    <a href={localizedPath(lang, `blog/${slug}`)}>
      {
        titleParts.map((part) =>
          part.type === 'mark' ? (
            <span class="term-rag">{part.value}</span>
          ) : (
            part.value
          ),
        )
      }
    </a>
  </h2>
  <p>
    {
      descriptionParts.map((part) =>
        part.type === 'mark' ? (
          <span class="term-rag">{part.value}</span>
        ) : (
          part.value
        ),
      )
    }
  </p>
  {post.data.tags.length > 0 && (
    <ul class="tag-list" aria-label={t.tags}>
      {post.data.tags.map((tag) => (
        <li class="tag">{tag}</li>
      ))}
    </ul>
  )}
</article>
